{
  "name": "vite-plugin-sveltekit-node-worker",
  "version": "1.0.1",
  "description": "Vite plugin for Node.js worker_threads in SvelteKit 3 with adapter-node.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@sveltejs/adapter-node": "^6.0.0-next.0",
    "@sveltejs/kit": "^3.0.0-next.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "keywords": [
    "vite",
    "plugin",
    "worker",
    "worker_threads",
    "node",
    "sveltekit",
    "adapter-node"
  ],
  "author": "n0tz3r0",
  "license": "MIT"
}
