{
  "name": "vite-plugin-sveltekit-node-worker",
  "version": "1.1.0",
  "description": "Vite plugin for Node.js worker_threads in SvelteKit 3 with adapter-node.",
  "keywords": [
    "adapter-node",
    "node",
    "plugin",
    "sveltekit",
    "vite",
    "worker",
    "worker_threads"
  ],
  "license": "MIT",
  "author": "n0tz3r0",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsdown": "^0.23.0",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "@sveltejs/adapter-node": "^6.0.0-next.0",
    "@sveltejs/kit": "^3.0.0-next.0",
    "vite": "^8.0.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
